<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-qa 自包含 parent — 不依赖 monorepo 内部 parent，
        坐标改造为 io.github.yuku123 namespace (Maven Central 命名空间)。
        使用 ${revision} (CI-friendly versions) + flatten-maven-plugin 发版自动替换。

        模块结构:
          - z-qa-core : 套件/计划/执行引擎 (QaExecutionDispatcher + QaRunRunner + ApiStepExecutor
                        + QaFailureClassifier + QaStepStatus) + entity/mapper/service + DDL
          - z-qa-web  : Spring Boot Controller 层 + AutoConfiguration (spring.factories)

        2026-09-28 从 z-opc monorepo 迁出。迁出口径「零版本漂移」:
        下面锁的 z-boot-*/z-msg/z-oss/z-util 版本 = 迁出前 z-opc 根 pom dependencyManagement
        实际喂给 z-qa 的那一份，运行进程里的字节没变。收敛到 z-boot 1.0.18 线是后续单独一次改动。
    -->
    <groupId>io.github.yuku123</groupId>
    <artifactId>z-qa</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>z-qa (Test Platform: Suite / Plan / Run / Dashboard)</name>
    <description>
        Z-QA: 测试平台（对标 TestRail / MeterSphere）。
        步骤式 API 链路执行 + 套件/计划/定时/报告/质量看板，十态步骤状态机与缺陷三分类，
        中止与 failFast 语义，Spring Boot AutoConfiguration 一行 import 即可启用。
    </description>

    <url>https://github.com/z-opc-foundation/z-qa</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-qa.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-qa.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-qa</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-qa-core</module>
        <module>z-qa-web</module>
    </modules>

    <properties>
        <!-- CI-friendly 版本根 (发版改这一处即可) -->
        <revision>1.0.0</revision>

        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>2.7.18</spring-boot.version>
        <log4j2.version>2.25.4</log4j2.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>

        <!-- 内部依赖 (与迁出前 z-opc 根 pom 喂给 z-qa 的版本一致) -->
        <z-boot-starter.version>1.0.3</z-boot-starter.version>
        <z-boot-msg-starter.version>1.0.11</z-boot-msg-starter.version>
        <z-msg.version>1.0.0</z-msg.version>
        <z-oss.version>1.0.2</z-oss.version>
        <z-util.version>1.0.13</z-util.version>

        <!-- Maven 插件版本 -->
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
        <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
        <central-publishing-maven-plugin.version>0.7.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Log4j2 BOM 必须排在 spring-boot-dependencies 之前：多个 import BOM 冲突时
                 Maven 取"先声明者"，而 ${log4j2.version} 属性覆写只对 parent 生效、对 import
                 进来的 BOM 无效。放在后面会让 log4j-api/core 被 Boot 拉回旧版，而 Boot 不认识的
                 log4j-slf4j2-impl 仍是 ${log4j2.version} —— 同一份 org.apache.logging.slf4j
                 包出现两个版本，启动即 NoSuchMethodError。 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 本仓 module -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-qa-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-qa-web</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- z-boot starters -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-web-starter</artifactId>
                <version>${z-boot-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-datasource-starter</artifactId>
                <version>${z-boot-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-msg-starter</artifactId>
                <version>${z-boot-msg-starter.version}</version>
            </dependency>

            <!-- z-msg / z-oss / z-util -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-msg-core</artifactId>
                <version>${z-msg.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-oss-core</artifactId>
                <version>${z-oss.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-parser-json</artifactId>
                <version>${z-util.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-core</artifactId>
                <version>${z-util.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-aop</artifactId>
                <version>${z-util.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-dsl</artifactId>
                <version>${z-util.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-boot-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 日志实现的唯一性靠人记"要排除 starter-logging"是记不住的。这条规则把约束钉在
                 构建上——新模块多引一个 starter 就会在 validate 阶段红，而不是等到运行时
                 NoSuchMethodError / 日志成环。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ban-competing-log-bindings</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- 反向桥：和 log4j-slf4j-impl 同时在 classpath 上即成环 -->
                                        <exclude>org.apache.logging.log4j:log4j-to-slf4j</exclude>
                                        <!-- SLF4J 2.x 绑定：与 1.7.36 的栈不同代，共用同一个 java 包 -->
                                        <exclude>org.apache.logging.log4j:log4j-slf4j2-impl</exclude>
                                        <!-- Boot 默认日志实现，本工程一律换 Log4j2 -->
                                        <exclude>org.springframework.boot:spring-boot-starter-logging</exclude>
                                        <exclude>ch.qos.logback:*</exclude>
                                        <exclude>org.slf4j:slf4j-log4j12</exclude>
                                        <exclude>org.slf4j:slf4j-simple</exclude>
                                    </excludes>
                                    <message>z-qa 只允许 Log4j2 + slf4j 1.7 一条绑定链，见 pom 顶部的日志说明</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <!-- oss 模式: 子 POM 完全 self-contained，自定义 ${xxx} 属性也会解析，
                         url/licenses/developers/scm 元数据保留 -->
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- _frontend 只作前端上游副本，不是 maven 模块；
                                 若将来加 example/admin 演示模块，必须在这里排除，
                                 否则会给 io.github.yuku123 多占一个不可复用的版本号 -->
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
