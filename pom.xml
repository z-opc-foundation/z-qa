<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-qa 自包含坐标：groupId 是 io.github.yuku123 (Maven Central 命名空间)，
        版本根用 ${revision} (CI-friendly) + 常开 flatten(oss) ⇒ 入库/发布件落成字面量、
        <parent> 被剥掉（现读 repo1 的 1.0.0：z-qa / z-qa-core / z-qa-web 三份 pom 的 <parent> 计数全为 0）。

        2026-09-29 起消费入口走 io.github.yuku123:z-boot-parent:1.0.19（全组织口径）：
        第三方地板 z-boot-dependencies + 兄弟仓权威 z-boot-fleet + Java 8 的 pluginManagement。
        relativePath 必须留空：parent 不在磁盘上，在 repo1。

        模块结构:
          - z-qa-core : 套件/计划/执行引擎 (QaExecutionDispatcher + QaRunRunner + ApiStepExecutor
                        + QaFailureClassifier + QaStepStatus) + entity/mapper/service + DDL
          - z-qa-web  : Spring Boot Controller 层 + AutoConfiguration (spring.factories)
    -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.0.19</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-qa</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>z-qa (Test Platform: Suite / Plan / Run / Dashboard)</name>
    <description>
        Z-QA: 测试平台（对标 TestRail / MeterSphere）。
        步骤式 API 链路执行 + 套件/计划/定时/报告/质量看板，十态步骤状态机与缺陷三分类，
        中止与 failFast 语义，Spring Boot AutoConfiguration 一行 import 即可启用。
    </description>

    <url>https://github.com/z-opc-foundation/z-qa</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-qa.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-qa.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-qa</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-qa-core</module>
        <module>z-qa-web</module>
    </modules>

    <properties>
        <!-- CI-friendly 版本根 (发版改这一处即可) -->
        <revision>1.0.1</revision>

        <!-- 与父链同值、已删的键（连同引用它们的 <version> 一起删）：
             maven.compiler.source 8 / maven.compiler.target 8 / project.build.sourceEncoding UTF-8
             spring-boot.version 2.7.18 / log4j2.version 2.25.4 / mybatis-plus.version 3.5.7
             z-util.version 1.0.13 —— 父链面值逐格相同，改由 parent 下发。
             ⚠ 键虽然删了，下面 flatten 那行对 ${flatten-maven-plugin.version} 的引用仍解析得到
             （父链供这一格 1.7.3，就是给消费方留的兜底）。 -->
        <!-- 父链不供（键与坐标都没有），留着： -->
        <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
        <central-publishing-maven-plugin.version>0.7.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 自家 reactor 坐标逐条钉 ${project.version}：fleet 里 z-qa 命中 0 条，不钉的话
                 继承来的 DM 会改写传递依赖的版本，把 repo1 的旧发布件打进本仓的包里。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-qa</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-qa-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-qa-web</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 以下坐标改由父链下发，本仓那 9 条 DM 条目连同属性键一并删除：
                 z-boot-web-starter / z-boot-datasource-starter 本仓 1.0.3 → 父链 1.0.19（ranged GET 206）
                 z-boot-msg-starter 本仓 1.0.11 → 父链 1.0.19（206）
                 z-msg-core 本仓 1.0.0 → fleet 1.2.1（206）
                 z-oss-core 本仓 1.0.2 → fleet 1.0.3（206）
                 z-util-core / -aop / -dsl / -parser-json 本仓 1.0.13 = fleet 1.0.13
                 com.baomidou:mybatis-plus-boot-starter 本仓 3.5.7 = 地板 3.5.7
                 ⚠ z-boot 那三格必须一起走：web/datasource 若自留在 1.0.3，本仓 DM 会直接把
                 z-boot-msg-starter:1.0.19 传递依赖的 web-starter 压回 1.0.3 —— 新 starter 配旧字节码。
                 两条 BOM import（log4j-bom、spring-boot-dependencies）删掉：地板已按坐标把
                 log4j-api/core/jul/slf4j-impl/to-slf4j 钉在 2.25.4（与本仓同值），
                 并 import 了同一个 spring-boot-dependencies:2.7.18。 -->

            <!-- 父链会把这两格**往回**压，按坐标写直接条目压住（口径同 z-kb、z-schedule）：
                 mybatis-spring 本仓基线 2.1.2（mybatis-plus-boot-starter 3.5.7 自带）vs 地板 2.0.6；
                 mysql-connector-j 本仓基线 8.0.33 vs 地板 8.4.0（8.4 换 driver 行为，且带进
                 com.google.protobuf:protobuf-java 一整件新传递依赖）。 -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>2.1.2</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.0.33</version>
                <!-- 删掉 spring-boot-dependencies 的 BOM import 会连带删掉**它那条受管项自带的
                     exclusion**（Boot 对 mysql-connector-j 排掉 protobuf-java）：只写版本的直接条目
                     是整条替换，实测 protobuf-java:3.25.5 从 mysql 底下冒进 core/web 两棵树
                     （基线里它不在）。照抄 Boot 的 exclusion 保持零漂移，同 z-mist 的写法。 -->
                <exclusions>
                    <exclusion>
                        <groupId>com.google.protobuf</groupId>
                        <artifactId>protobuf-java</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 日志实现的唯一性靠人记"要排除 starter-logging"是记不住的。这条规则把约束钉在
                 构建上——新模块多引一个 starter 就会在 validate 阶段红，而不是等到运行时
                 NoSuchMethodError / 日志成环。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ban-competing-log-bindings</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <!-- 反向桥：和 log4j-slf4j-impl 同时在 classpath 上即成环 -->
                                        <exclude>org.apache.logging.log4j:log4j-to-slf4j</exclude>
                                        <!-- SLF4J 2.x 绑定：与 1.7.36 的栈不同代，共用同一个 java 包 -->
                                        <exclude>org.apache.logging.log4j:log4j-slf4j2-impl</exclude>
                                        <!-- Boot 默认日志实现，本工程一律换 Log4j2 -->
                                        <exclude>org.springframework.boot:spring-boot-starter-logging</exclude>
                                        <exclude>ch.qos.logback:*</exclude>
                                        <exclude>org.slf4j:slf4j-log4j12</exclude>
                                        <exclude>org.slf4j:slf4j-simple</exclude>
                                    </excludes>
                                    <message>z-qa 只允许 Log4j2 + slf4j 1.7 一条绑定链，见 pom 顶部的日志说明</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 常开（不挂 central profile）：本仓发的是自包含 pom，parent 那条 flatten 是
                 inherited=false、不下发，所以这条必须留着，形状才和 repo1 上的 1.0.0 一致。
                 版本键已删，${flatten-maven-plugin.version} 由父链解析（1.7.3）。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <!-- oss 模式: 子 POM 完全 self-contained，自定义 ${xxx} 属性也会解析，
                         url/licenses/developers/scm 元数据保留，<parent> 被剥掉 -->
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- maven-compiler-plugin 的声明删掉：父链 pluginManagement 供 3.11.0 +
                 source/target 8 + UTF-8 + -parameters（本仓原来那份没有 -parameters）。 -->
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- _frontend 只作前端上游副本，不是 maven 模块；
                                 若将来加 example/admin 演示模块，必须在这里排除，
                                 否则会给 io.github.yuku123 多占一个不可复用的版本号 -->
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
