<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zifang.z.qa.admin.domain.mapper.QaE2eActionMapper">
    <resultMap id="BaseResultMap" type="com.zifang.z.qa.admin.domain.entity.QaE2eActionDO">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="step_no" property="stepNo"/>
        <result column="action_type" property="actionType"/>
        <result column="selector" property="selector"/>
        <result column="action_value" property="actionValue"/>
        <result column="description" property="description"/>
        <result column="screenshot_oss_key" property="screenshotOssKey"/>
        <result column="e2e_screenshot" property="e2eScreenshot"/>
        <result column="result" property="result"/>
        <result column="error_message" property="errorMessage"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="started_at" property="startedAt"/>
        <result column="finished_at" property="finishedAt"/>
        <result column="tenant_code" property="tenantCode"/>
    </resultMap>

    <select id="selectBySessionId" resultMap="BaseResultMap">
        SELECT *
        FROM z_qa_e2e_action
        WHERE session_id = #{sessionId}
        ORDER BY step_no ASC
    </select>
</mapper>
